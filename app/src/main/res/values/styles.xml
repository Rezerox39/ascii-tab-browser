<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AsciiTab" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/amole_bg</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="popupMenuStyle">@style/PopupMenu.AsciiTab</item>
    </style>

    <style name="PopupMenu.AsciiTab" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_glass_dialog</item>
        <item name="android:textColor">#E2E8F0</item>
    </style>

    <style name="GlassDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
